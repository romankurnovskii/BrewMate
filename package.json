{
  "name": "brewmate",
  "version": "1.0.40",
  "description": "BrewMate - A modern Homebrew package manager GUI for macOS and Linux",
  "author": {
    "name": "Roman Kurnovskii",
    "email": "romankurnovskii@gmail.com"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run build:renderer && npm run copy:static",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "copy:static": "mkdir -p dist/renderer && mkdir -p dist/assets && mkdir -p dist/locales && cp src/renderer/index.html dist/renderer/ && cp src/renderer/styles.css dist/renderer/ && cp locales/*.json dist/locales/ && if [ -d src/assets ]; then cp -r src/assets/* dist/assets/; elif [ -d assets ]; then cp -r assets/* dist/assets/; fi && if [ -f src/assets/categories.json ]; then cp src/assets/categories.json dist/assets/categories.json; fi",
    "start": "electron .",
    "start:dev": "NODE_ENV=development npm start",
    "build:mac": "npm run build && electron-builder --mac",
    "build:mac:universal": "./scripts/build-direct-universal.sh",
    "build:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "build:mac:x64": "npm run build && electron-builder --mac --x64",
    "build:linux": "npm run build && electron-builder --linux --publish=never",
    "build:mas": "./scripts/build-mas-universal.sh",
    "pre-submit": "echo 'Pre-submit check not implemented yet'",
    "dist": "npm run build && electron-builder --mac",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "dotenv": "^17.2.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-rebuild": "^3.2.9",
    "jest": "^30.3.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "i18next": "^26.4.0",
    "node-pty": "^1.1.0"
  },
  "overrides": {
    "node-abi": "^4.35.0"
  }
}
